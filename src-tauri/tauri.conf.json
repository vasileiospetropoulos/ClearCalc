{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClearCalc",
  "version": "1.0.0",
  "identifier": "com.vasileiospetropoulos.clearcalc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ClearCalc",
        "width": 960,
        "height": 840,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A clean, responsive scientific calculator and mathematical function evaluator",
    "longDescription": "A clean, responsive scientific calculator and mathematical function evaluator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
